# YouTube Thumbnail Generator - Environment Variables
# ====================================================
# Copy this file to .env and fill in your API keys
#
# IMPORTANT: Never commit your .env file to version control!
# The .env file is ignored by .gitignore

# =============================================================================
# DIRECTORIES
# =============================================================================

# Source directory containing videos to process
VIDEOS_DIR=./videos

# Output directory for generated thumbnails and intermediate files
# OUTPUT_DIR=./output  # Default: output folder inside the project directory

# =============================================================================
# API KEYS
# =============================================================================

# ElevenLabs API for transcription (speech-to-text)
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Google Gemini API for image generation
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude API for prompt generation
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API (optional, for GPT Image or DALL-E)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Poe API (optional, for FLUX models with face preservation)
# Get your key at: https://poe.com/developers
POE_API_KEY=

# =============================================================================
# GRAN SABIO LLM INTEGRATION (Required for Web Interface)
# =============================================================================

# Gran Sabio LLM is required for the web interface prompt generation.
# Clone it from: https://github.com/jordicor/GranSabio_LLM

# Path to the Gran Sabio LLM 'client' folder
# Example: C:/Projects/Gran_Sabio_LLM/client
GRANSABIO_CLIENT_PATH=

# URL where Gran Sabio LLM server is running
GRANSABIO_LLM_URL=http://localhost:8000

# =============================================================================
# IMAGE GENERATION SETTINGS
# =============================================================================

# Default image provider: gemini, openai, poe, replicate
# This application uses reference images with GPT Image models; DALL-E 3 does not support them.
IMAGE_PROVIDER=gemini

# Gemini model for image generation:
#   gemini-2.5-flash-image           - Fast, good quality (default)
#   gemini-3-pro-image-preview       - Best quality, 4K (Nano Banana Pro)
#   gemini-3.1-flash-image-preview   - Fast, 4K, 14 refs (Nano Banana 2)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI model:
#   gpt-image-2      - Latest (2026-04-21): multilingual text, native reasoning, up to 2K/4K
#   gpt-image-1.5    - High quality
#   gpt-image-1      - Standard (default)
#   gpt-image-1-mini - Faster, lower cost
#   dall-e-3         - Legacy (deprecated, NO reference image support)
OPENAI_IMAGE_MODEL=gpt-image-1

# Poe model (use exact bot names - no hyphens in flux models):
#   flux2pro        - Best quality, up to 8 references (default)
#   flux2flex       - High resolution (14MP)
#   fluxkontextpro  - Best prompt following
#   seedream40      - Good for combining references
#   nanobananapro   - Gemini 3 Pro via Poe
#   Ideogram-v3     - Best for text/logos
POE_IMAGE_MODEL=flux2pro

# =============================================================================
# TRANSCRIPTION SETTINGS
# =============================================================================

# Use local Whisper model instead of ElevenLabs API
USE_LOCAL_WHISPER=false

# Whisper model: tiny, base, small, medium, large, turbo
WHISPER_MODEL=turbo

# Transcription language (ISO 639-1 code)
TRANSCRIPTION_LANGUAGE=es

# ElevenLabs Scribe model: scribe_v1, scribe_v2 (default)
# scribe_v2 offers keyterm prompting, entity detection, and improved accuracy
ELEVENLABS_MODEL=scribe_v2

# Keyterms to bias transcription towards specific words (optional)
# Comma-separated list, max 100 terms, each <50 characters
# Useful for: channel names, product names, technical jargon, proper nouns
# Example: ELEVENLABS_KEYTERMS=MiCanal,ProductoX,NombrePropio
ELEVENLABS_KEYTERMS=

# Entity detection: detect entities with exact timestamps (optional, additional cost)
# Options: "" (disabled), "all", "pii" (personal info), "phi" (health info), "pci" (payment cards)
# Can combine: "pii,pci"
ELEVENLABS_ENTITY_DETECTION=

# =============================================================================
# FACE DETECTION SETTINGS
# =============================================================================

# InsightFace model: buffalo_l, buffalo_s, buffalo_sc
FACE_DETECTOR_MODEL=buffalo_l

# Minimum confidence threshold for face detection (0.0-1.0)
FACE_CONFIDENCE_THRESHOLD=0.5

# Similarity threshold for face matching (0.0-1.0)
FACE_SIMILARITY_THRESHOLD=0.4

# Maximum number of best frames to select
MAX_BEST_FRAMES=10

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path (relative to project directory)
DATABASE_PATH=./database/thumbnails.db

# =============================================================================
# SERVER SETTINGS (for FastAPI)
# =============================================================================

# Host and port for the web server
SERVER_HOST=0.0.0.0
SERVER_PORT=8057

# Enable debug/reload mode (development only)
DEBUG_MODE=true

# =============================================================================
# REDIS SETTINGS (Job Queue)
# =============================================================================

# Redis connection URL (default: Laragon Redis on localhost)
REDIS_URL=redis://localhost:6379/0

# Maximum Redis connections in pool
REDIS_MAX_CONNECTIONS=10

# Maximum concurrent jobs per worker (limited by GPU memory)
WORKER_MAX_JOBS=2

# Job timeouts in seconds
JOB_TIMEOUT_ANALYSIS=1800
JOB_TIMEOUT_GENERATION=900

# Maximum retry attempts for failed jobs
JOB_MAX_RETRIES=3
